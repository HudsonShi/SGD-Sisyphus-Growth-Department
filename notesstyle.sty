\numberwithin{equation}{chapter}
\numberwithin{figure}{chapter}
\numberwithin{table}{chapter}

%==============================================================================
% 5. 定理类环境
%==============================================================================
\theoremstyle{definition}
\newtheorem{definition}{定义}[chapter]
\newtheorem{example}{示例}[chapter]
\newtheorem{remark}{评注}[chapter]
\theoremstyle{plain}
\newtheorem{theorem}{定理}[chapter]
\newtheorem{lemma}{引理}[chapter]
\newtheorem{proposition}{命题}[chapter]
\newtheorem{corollary}{推论}[chapter]

%==============================================================================
% 6. 提示框：核心要点 / 案例 / 陷阱 / 洞察 / 工具 / 思考题 / 公式卡
%==============================================================================
\tcbset{
  boxrule  = 0.6pt,
  arc      = 2pt,
  left     = 6pt, right = 6pt, top = 5pt, bottom = 5pt,
  fonttitle= \sffamily\bfseries\small,
  before skip = 9pt, after skip = 9pt,
  breakable,
  enhanced
}

\newtcolorbox{keypoint}[1][核心要点]{
  colback=BoxBG, colframe=NavyMid, coltitle=white,
  title={#1},
  attach boxed title to top left={xshift=6pt,yshift=-\tcboxedtitleheight/2},
  boxed title style={colback=NavyMid, arc=1pt, boxrule=0pt}
}

\newtcolorbox{insight}[1][洞察]{
  colback=BoxBGAlt, colframe=TealDeep, coltitle=white,
  title={#1},
  attach boxed title to top left={xshift=6pt,yshift=-\tcboxedtitleheight/2},
  boxed title style={colback=TealDeep, arc=1pt, boxrule=0pt}
}

\newtcolorbox{casebox}[1][案例]{
  colback=white, colframe=TealDeep, coltitle=white,
  title={#1},
  attach boxed title to top left={xshift=6pt,yshift=-\tcboxedtitleheight/2},
  boxed title style={colback=TealDeep, arc=1pt, boxrule=0pt}
}

\newtcolorbox{pitfall}[1][常见陷阱]{
  colback=white, colframe=CrimsonDeep, coltitle=white,
  title={#1},
  attach boxed title to top left={xshift=6pt,yshift=-\tcboxedtitleheight/2},
  boxed title style={colback=CrimsonDeep, arc=1pt, boxrule=0pt}
}

\newtcolorbox{toolbox}[1][工具与实操]{
  colback=white, colframe=AmberDeep, coltitle=white,
  title={#1},
  attach boxed title to top left={xshift=6pt,yshift=-\tcboxedtitleheight/2},
  boxed title style={colback=AmberDeep, arc=1pt, boxrule=0pt}
}

\newtcolorbox{interview}[1][面试追问]{
  colback=white, colframe=VioletDeep, coltitle=white,
  title={#1},
  attach boxed title to top left={xshift=6pt,yshift=-\tcboxedtitleheight/2},
  boxed title style={colback=VioletDeep, arc=1pt, boxrule=0pt}
}

\newtcolorbox{formulacard}[1][公式速记]{
  colback=BoxBG, colframe=SlateGray, coltitle=white,
  title={#1},
  attach boxed title to top left={xshift=6pt,yshift=-\tcboxedtitleheight/2},
  boxed title style={colback=SlateGray, arc=1pt, boxrule=0pt}
}

%==============================================================================
% 7. 代码排版（代码块请只用 ASCII 字符，中文请放在正文说明中）
%==============================================================================
\RequirePackage{listings}
\lstdefinestyle{growth}{
  basicstyle       = \ttfamily\scriptsize,
  keywordstyle     = \color{NavyMid}\bfseries,
  commentstyle     = \color{TealDeep}\itshape,
  stringstyle      = \color{CrimsonDeep},
  numberstyle      = \tiny\color{SlateGray},
  numbers          = left,
  numbersep        = 6pt,
  backgroundcolor  = \color{CodeBG},
  frame            = single,
  rulecolor        = \color{RuleGray},
  framexleftmargin = 14pt,
  showstringspaces = false,
  breaklines       = true,
  breakatwhitespace= false,
  columns          = fullflexible,
  keepspaces       = true,
  tabsize          = 4,
  captionpos       = b,
  upquote          = true
}
\lstdefinestyle{growthnoline}{
  style = growth, numbers = none, framexleftmargin = 6pt
}
\lstset{style=growth}

\lstdefinelanguage{SQLx}{
  morekeywords={SELECT,FROM,WHERE,GROUP,BY,ORDER,LIMIT,JOIN,LEFT,RIGHT,INNER,
    OUTER,ON,AS,AND,OR,NOT,IN,COUNT,SUM,AVG,MAX,MIN,CASE,WHEN,THEN,ELSE,END,
    WITH,UNION,ALL,DISTINCT,INSERT,INTO,VALUES,UPDATE,SET,DELETE,PARTITION,
    OVER,ROW_NUMBER,RANK,DENSE_RANK,WINDOW,HAVING,CREATE,TABLE,ALTER,INDEX,
    EXPLAIN,ANALYZE},
  sensitive=false,
  morecomment=[l]{--},
  morestring=[b]'
}
\lstdefinelanguage{PyTorch}[]{Python}{
  morekeywords={torch,nn,optim,Tensor,Module,Parameter,DataLoader,Dataset,
    F,functional,device,cuda,backward,zero_grad,step,forward,embedding,
    linear,softmax,cross_entropy,adam,sgd,lr,epoch,batch_size}
}
\lstdefinelanguage{json}{
  string=[s]{"}{"},
  stringstyle=\color{CrimsonDeep},
  morestring=[b]',
  comment=[l]{//},
  literate=
    *{0}{{{\color{NavyMid}0}}}{1}
     {1}{{{\color{NavyMid}1}}}{1}
     {2}{{{\color{NavyMid}2}}}{1}
     {3}{{{\color{NavyMid}3}}}{1}
     {4}{{{\color{NavyMid}4}}}{1}
     {5}{{{\color{NavyMid}5}}}{1}
     {6}{{{\color{NavyMid}6}}}{1}
     {7}{{{\color{NavyMid}7}}}{1}
     {8}{{{\color{NavyMid}8}}}{1}
     {9}{{{\color{NavyMid}9}}}{1}
     {:}{{{\color{SlateGray}{:}}}}{1}
     {,}{{{\color{SlateGray}{,}}}}{1}
     {\{}{{{\color{NavyDeep}{\{}}}}{1}
     {\}}{{{\color{NavyDeep}{\}}}}}{1}
     {[}{{{\color{NavyDeep}{[}}}}{1}
     {]}{{{\color{NavyDeep}{]}}}}{1}
}
\lstdefinelanguage{yaml}{
  keywords={true,false,null,y,n},
  keywordstyle=\color{NavyMid}\bfseries,
  basicstyle=\ttfamily\scriptsize,
  sensitive=true,
  comment=[l]{\#},
  morecomment=[s]{/*}{*/},
  morestring=[b]',
  morestring=[b]"
}

\newcommand{\codefile}[2]{%
  \lstinputlisting[style=growth,caption={#1}]{#2}%
}

%==============================================================================
% 8. 表格辅助
%==============================================================================
\renewcommand{\arraystretch}{1.25}
\newcolumntype{L}[1]{>{\raggedright\arraybackslash}p{#1}}
\newcolumntype{C}[1]{>{\centering\arraybackslash}p{#1}}
\newcolumntype{R}[1]{>{\raggedleft\arraybackslash}p{#1}}
\newcolumntype{Y}{>{\raggedright\arraybackslash}X}
\newcommand{\tabhead}[1]{\textbf{\color{NavyDeep}#1}}

%==============================================================================
% 9. 列表样式
%==============================================================================
\setlist[itemize,1]{label=\textcolor{NavyMid}{\textbullet}, leftmargin=1.6em, itemsep=2pt, topsep=3pt}
\setlist[itemize,2]{label=\textcolor{TealDeep}{\textendash}, leftmargin=1.4em, itemsep=1pt, topsep=2pt}
\setlist[enumerate,1]{label=\textcolor{NavyMid}{\arabic*.}, leftmargin=1.8em, itemsep=2pt, topsep=3pt}
\setlist[enumerate,2]{label=\textcolor{TealDeep}{(\alph*)}, leftmargin=1.6em, itemsep=1pt}

%==============================================================================
% 10. 参考文献（natbib + gbt7714 + bibtex，兼容 GB/T 7714-2015 国标格式）
%     注意：本机 TeX Live 的 biber 二进制不可用，故采用 bibtex 后端。
%     若要改用 biblatex/biber，请把本节替换为 biblatex 配置并调整 Makefile。
%==============================================================================
\RequirePackage[numbers,sort&compress]{gbt7714}

%==============================================================================
% 11. 超链接与引用
%==============================================================================
\RequirePackage{hyperref}
\hypersetup{
  colorlinks = true,
  linkcolor  = NavyDeep,
  citecolor  = TealDeep,
  urlcolor   = VioletDeep,
  filecolor  = VioletDeep,
  bookmarksnumbered = true,
  bookmarksopen = true,
  pdftitle   = {增长技术笔记},
  pdfauthor  = {SGD Notes},
  pdfsubject = {推荐算法 · 搜索引擎 · 计算广告 · NLP · SEO · GEO · 广告投流 · 跨境电商供应链}
}
\RequirePackage{cleveref}
\crefname{chapter}{第}{第}
\crefname{section}{节}{节}
\crefname{equation}{式}{式}
\crefname{figure}{图}{图}
\crefname{table}{表}{表}
\crefname{theorem}{定理}{定理}
\crefname{definition}{定义}{定义}

%==============================================================================
% 12. 杂项
%==============================================================================
\captionsetup{
  font      = small,
  labelfont = {sf,bf},
  labelsep  = quad,
  justification = centering
}
\setcounter{tocdepth}{1}
\setcounter{secnumdepth}{3}

% 让 \paragraph 更紧凑好用
\makeatletter
\renewcommand\paragraph{\@startsection{paragraph}{4}{\z@}%
  {1.2ex \@plus .3ex \@minus .2ex}{0.6ex}%
  {\normalfont\normalsize\sffamily\bfseries\color{SlateGray}}}
\makeatother

% 术语表命令：\gloss{中文}{English}{说明}——用于附录术语表
\newcommand{\gloss}[3]{#1 & #2 & #3 \\}
\endinput
