%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
%% notesstyle.sty —— 《增长技术笔记》统一排版样式
%% 编译方式：xelatex -> biber -> xelatex -> xelatex
%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{notesstyle}[2025/01/01 v1.0 Growth-Tech Notes Style]

%==============================================================================
% 1. 页面与版式
%==============================================================================
\RequirePackage{geometry}
\geometry{
  paper      = a4paper,
  top        = 2.6cm,
  bottom     = 2.6cm,
  left       = 2.6cm,
  right      = 2.4cm,
  headheight = 15pt,
  headsep    = 8mm,
  footskip   = 12mm
}

\RequirePackage{xcolor}
\definecolor{NavyDeep}{HTML}{12355B}
\definecolor{NavyMid}{HTML}{1F5C99}
\definecolor{TealDeep}{HTML}{0B6E4F}
\definecolor{AmberDeep}{HTML}{A15C00}
\definecolor{CrimsonDeep}{HTML}{9B1B30}
\definecolor{VioletDeep}{HTML}{5B2A86}
\definecolor{SlateGray}{HTML}{4A5568}
\definecolor{BoxBG}{HTML}{F7F9FC}
\definecolor{BoxBGAlt}{HTML}{F3F7F4}
\definecolor{CodeBG}{HTML}{F5F5F2}
\definecolor{RuleGray}{HTML}{D9DEE7}

\RequirePackage{amsmath,amssymb,amsthm,mathtools,bm}
\RequirePackage{mathrsfs}
\RequirePackage{booktabs,longtable,tabularx,xltabular,array,multirow,makecell}
\RequirePackage{enumitem}
\RequirePackage{graphicx}
\RequirePackage{adjustbox}
\RequirePackage{rotating}
\RequirePackage{pdflscape}
\RequirePackage{caption}
\RequirePackage{subcaption}
\RequirePackage{siunitx}
\RequirePackage{etoolbox}
\RequirePackage{xpatch}
\RequirePackage{morefloats}
\extrafloats{1000}
\RequirePackage{fancyhdr}
\RequirePackage{tikz}
\RequirePackage{pgfplots}
\pgfplotsset{compat=1.18}
\usetikzlibrary{arrows.meta,positioning,shapes.geometric,shadows.blur,fit,
  backgrounds,calc,decorations.pathreplacing,matrix,chains,patterns}
\RequirePackage{forest}
\RequirePackage{tcolorbox}
\tcbuselibrary{skins,breakable,raster}

%==============================================================================
% 2. 中文标题样式（使用 ctexset，避免 titlesec 与 ctexbook 冲突）
%==============================================================================
\ctexset{
  chapter = {
    name   = {第,章},
    number = \arabic{chapter},
    format = \normalfont\sffamily\bfseries\Large\color{NavyDeep},
    nameformat = {},
    titleformat = {},
    aftername = \hspace{0.4em},
    beforeskip = 8pt,
    afterskip  = 18pt,
    pagestyle  = fancy
  },
  section = {
    format = \normalfont\sffamily\bfseries\large\color{NavyMid},
    aftername = \hspace{0.35em}
  },
  subsection = {
    format = \normalfont\sffamily\bfseries\normalsize\color{SlateGray},
    aftername = \hspace{0.3em}
  },
  subsubsection = {
    format = \normalfont\sffamily\bfseries\small\color{SlateGray}
  },
  part = {
    format = \centering\normalfont\sffamily\bfseries\Huge\color{NavyDeep},
    name   = {第,部分},
    number = \arabic{part}
  }
}

%==============================================================================
% 3. 页眉页脚
%==============================================================================
\pagestyle{fancy}
\fancyhf{}
\renewcommand{\headrulewidth}{0.4pt}
\renewcommand{\footrulewidth}{0pt}
\fancyhead[L]{\small\sffamily\color{SlateGray}\leftmark}
\fancyhead[R]{\small\sffamily\color{SlateGray}\thepage}
\fancyfoot[C]{\scriptsize\sffamily\color{SlateGray}增长技术笔记 · 推荐 / 搜索 / 广告 / NLP / SEO / GEO / 投流 / 跨境电商}
\fancypagestyle{plain}{%
  \fancyhf{}%
  \renewcommand{\headrulewidth}{0pt}%
  \fancyfoot[C]{\small\sffamily\color{SlateGray}\thepage}%
}

%==============================================================================
% 4. 常用宏
%==============================================================================
% 术语：中文（English）
\newcommand{\term}[2]{\textbf{#1}（\textit{#2}）}
% 内联代码
\newcommand{\code}[1]{\texttt{\small #1}}
% 关键词强调
\newcommand{\kw}[1]{\textbf{\color{NavyMid}#1}}
% 英文原词
\newcommand{\en}[1]{\textit{#1}}
% 指标名（小型大写风格）
\newcommand{\metric}[1]{\textsf{#1}}
% 待办/扩展标记
\newcommand{\todo}[1]{\textcolor{CrimsonDeep}{\textbf{[TODO: #1]}}}
